# Unity YAML — text, so scenes and prefabs stay diffable. Serialization mode is
# already Force Text in ProjectSettings/EditorSettings.asset.
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.physicMaterial2D text eol=lf
*.asmdef     text eol=lf
*.asmref     text eol=lf
*.shader     text eol=lf
*.shadergraph text eol=lf
*.cs         text eol=lf diff=csharp

# Binary assets go to LFS. Scoped to unity/ deliberately: the prototype's own
# images are already in plain git history and are left alone.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.psb  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text
